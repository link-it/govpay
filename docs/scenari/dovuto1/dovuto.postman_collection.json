			"item": [
				{
					"name": "PUT Pendenza",
					"request": {
						"auth": {
							"type": "basic",
							"basic": {
								"password": "{{passwordGestionale}}",
								"username": "{{usernameGestionale}}"
							}
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"name": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idTipoPendenza\": \"SANZIONE\",\n  \"idDominio\": \"01234567890\",\n  \"causale\": \"Sanzione CdS n. abc00000\",\n  \"soggettoPagatore\": {\n    \"tipo\": \"F\",\n    \"identificativo\": \"PSSMRA30A01H501I\",\n    \"anagrafica\": \"Mario Possi\"\n  },\n  \"importo\": 100.01,\n  \"tassonomiaAvviso\": \"Multe e sanzioni amministrative\",\n  \"dataValidita\": \"2026-12-31\",\n  \"dataScadenza\": \"2027-12-31\",\n  \"voci\": [\n    {\n      \"idVocePendenza\": \"1\",\n      \"importo\": 100.01,\n      \"descrizione\": \"Sanzione per divieto di sosta\",\n      \"ibanAccredito\": \"IT02L1234500000999990000001\",\n      \"tipoContabilita\": \"ALTRO\",\n      \"codiceContabilita\": \"ABC\"\n    }\n  ]\n}"
						},
						"url": "{{pendenze-baseurl}}/rs/basic/v2/pendenze/{{idGestionale}}/{{idPendenza}}"
					},
					"response": []
				},
				{
					"name": "GET Posizione Debitoria (govpay-portal-api)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-SPID-FISCALNUMBER",
								"value": "{{codiceFiscaleDebitore}}",
								"type": "text"
							}
						],
						"url": "{{portal-baseurl}}/pendenze/{{idDominio}}?stato=NON_ESEGUITA"
					},
					"response": []
				},
				{
					"name": "GET Ricevuta (govpay-portal-api)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/pdf",
								"type": "text"
							},
							{
								"key": "X-SPID-FISCALNUMBER",
								"value": "{{codiceFiscaleDebitore}}",
								"type": "text"
							}
						],
						"url": "{{portal-baseurl}}/pendenze/{{idDominio}}/{{numeroAvviso}}/ricevuta"
					},
					"response": []
				}
			]
		}
	],
