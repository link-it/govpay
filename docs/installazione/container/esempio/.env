# ---------------------------------------------------------------------------
# Composizione del rilascio GovPay 3.10.0
#
# Le versioni delle immagini sono quelle previste dal rilascio. Per i componenti
# che portano struttura di database sono le stesse dichiarate in
# src/main/resources/db/release-components.env del progetto govpay, che
# e' il file che registra la composizione del rilascio ed e' aggiornato nello
# stesso commit che porta la versione del core.
# ---------------------------------------------------------------------------

# Core
# NB: il tag dell'immagine del core porta in coda il dialetto del database
#     (_postgres, _oracle, _mysql, _mariadb), perche' l'immagine include il
#     driver JDBC corrispondente.
GOVPAY_VERSION=3.10.0
GOVPAY_DB_DIALECT=postgres

# Console di backoffice e relative API
CONSOLE_VERSION=1.0.0
CONSOLE_API_VERSION=1.0.0

# Microservizi
GDE_VERSION=2.0.0
STAMPE_VERSION=2.0.0

# Batch
BATCH_ACA_VERSION=2.0.1
BATCH_FDR_VERSION=2.0.2
BATCH_IBAN_VERSION=2.0.1
BATCH_MAGGIOLI_VERSION=2.0.1
BATCH_NOTIFY_VERSION=2.0.2
BATCH_RT_VERSION=2.0.1
BATCH_TRACCIATI_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
GOVPAY_DB_NAME=govpay
GOVPAY_DB_USER=govpay
GOVPAY_DB_PASSWORD=govpay

# ---------------------------------------------------------------------------
# Utenza applicativa usata dai batch per invocare le API del core.
# Va creata in anagrafica prima di avviare i batch.
# ---------------------------------------------------------------------------
GOVPAY_BATCH_USER=gpBatch
GOVPAY_BATCH_PASSWORD=CambiaQuestaPassword1!

# ---------------------------------------------------------------------------
# Porte esposte sull'host e livello di log
# ---------------------------------------------------------------------------
CORE_HTTP_PORT=8080
CONSOLE_HTTP_PORT=8081
GOVPAY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Posta elettronica, per promemoria e ricevute. Valorizzare con il server SMTP
# dell'ente: senza, le spedizioni falliscono e restano in coda.
# ---------------------------------------------------------------------------
GOVPAY_MAIL_SMTP_HOST=smtp.example.org
GOVPAY_MAIL_SMTP_PORT=25
